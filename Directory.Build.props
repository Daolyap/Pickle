<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Required by [LibraryImport] source-generated P/Invoke (Win32 console, token and pipe APIs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Authors>Pickle contributors</Authors>
    <Product>Pickle</Product>
    <Copyright>Copyright (c) Pickle contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/daolyap/milkshell</RepositoryUrl>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CS1591: missing XML docs. NU1603/NU1608: PowerShell SDK transitive version ranges. -->
    <NoWarn>$(NoWarn);CS1591;NU1603;NU1608</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or '$(MSBuildProjectName)' == 'Pickle.Testing' Or '$(MSBuildProjectName)' == 'Pickle.E2E'">
    <IsPackable>false</IsPackable>
    <!-- Tests may use platform-specific APIs behind runtime guards/skips. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
