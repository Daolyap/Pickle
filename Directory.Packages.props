<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.6" />
    <PackageVersion Include="System.Management.Automation" Version="7.6.6" />
    <!-- UI -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Terminal.Gui" Version="2.5.0" />
    <!-- Windows integrations -->
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />
    <!-- Misc -->
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.12" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
