{
  "name": "everforest",
  "description": "Everforest: green-tinted forest tones that are easy on the eyes.",
  "terminal": {
    "background": "#2D353B",
    "foreground": "#D3C6AA",
    "cursorColor": "#D3C6AA",
    "selectionBackground": "#475258",
    "black": "#475258",
    "red": "#E67E80",
    "green": "#A7C080",
    "yellow": "#DBBC7F",
    "blue": "#7FBBB3",
    "purple": "#D699B6",
    "cyan": "#83C092",
    "white": "#D3C6AA",
    "brightBlack": "#859289",
    "brightRed": "#E67E80",
    "brightGreen": "#A7C080",
    "brightYellow": "#DBBC7F",
    "brightBlue": "#7FBBB3",
    "brightPurple": "#D699B6",
    "brightCyan": "#83C092",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#83C092",
    "unknownCommand": "#E67E80",
    "parameter": "#859289",
    "string": "#A7C080",
    "number": "#D699B6",
    "variable": "#D3C6AA",
    "operator": "#7FBBB3",
    "keyword": "#7FBBB3",
    "comment": "#859289",
    "type": "#83C092",
    "member": "#D3C6AA",
    "error": "#E67E80",
    "suggestion": "#859289",
    "selectionBackground": "#475258",
    "translated": "#859289"
  },
  "ui": {
    "accent": "#A7C080",
    "muted": "#859289",
    "success": "#A7C080",
    "warning": "#DBBC7F",
    "error": "#E67E80",
    "info": "#7FBBB3",
    "panelBackground": "#2D353B",
    "panelForeground": "#D3C6AA",
    "panelBorder": "#475258",
    "highlightBackground": "#475258",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#343F44",
    "menuForeground": "#D3C6AA",
    "menuSelectedBackground": "#A7C080",
    "menuSelectedForeground": "#000000",
    "menuDescription": "#859289",
    "matchHighlight": "#DBBC7F"
  },
  "prompt": {
    "separator": "plain",
    "newlineBeforeInput": false,
    "promptChar": "\u276f",
    "promptCharColor": "#A7C080",
    "promptCharErrorColor": "#E67E80",
    "continuationPrompt": "\u2219 ",
    "transientTemplate": "{promptChar} ",
    "left": [
      {
        "type": "admin",
        "foreground": "#E67E80",
        "options": {
          "symbol": "ADMIN"
        }
      },
      {
        "type": "venv",
        "foreground": "#DBBC7F",
        "template": "({value})"
      },
      {
        "type": "cwd",
        "foreground": "#A7C080",
        "options": {
          "maxDepth": "3"
        }
      },
      {
        "type": "git",
        "foreground": "#A7C080",
        "template": "{icon} {value}",
        "icon": "\ue0a0"
      },
      {
        "type": "duration",
        "foreground": "#DBBC7F",
        "template": "took {value}"
      },
      {
        "type": "jobs",
        "foreground": "#83C092",
        "template": "\u2699 {value}"
      }
    ],
    "right": [
      {
        "type": "status",
        "foreground": "#E67E80"
      },
      {
        "type": "time",
        "foreground": "#859289",
        "options": {
          "format": "HH:mm"
        }
      }
    ]
  }
}
