{
  "name": "github-dark",
  "description": "GitHub's dark theme with plain segments.",
  "terminal": {
    "background": "#0D1117",
    "foreground": "#C9D1D9",
    "cursorColor": "#C9D1D9",
    "selectionBackground": "#264F78",
    "black": "#484F58",
    "red": "#FF7B72",
    "green": "#3FB950",
    "yellow": "#D29922",
    "blue": "#58A6FF",
    "purple": "#BC8CFF",
    "cyan": "#39C5CF",
    "white": "#B1BAC4",
    "brightBlack": "#6E7681",
    "brightRed": "#FF7B72",
    "brightGreen": "#3FB950",
    "brightYellow": "#D29922",
    "brightBlue": "#58A6FF",
    "brightPurple": "#BC8CFF",
    "brightCyan": "#39C5CF",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#39C5CF",
    "unknownCommand": "#FF7B72",
    "parameter": "#6E7681",
    "string": "#3FB950",
    "number": "#BC8CFF",
    "variable": "#C9D1D9",
    "operator": "#58A6FF",
    "keyword": "#58A6FF",
    "comment": "#8B949E",
    "type": "#39C5CF",
    "member": "#C9D1D9",
    "error": "#FF7B72",
    "suggestion": "#8B949E",
    "selectionBackground": "#264F78",
    "translated": "#8B949E"
  },
  "ui": {
    "accent": "#58A6FF",
    "muted": "#6E7681",
    "success": "#3FB950",
    "warning": "#D29922",
    "error": "#FF7B72",
    "info": "#58A6FF",
    "panelBackground": "#0D1117",
    "panelForeground": "#C9D1D9",
    "panelBorder": "#264F78",
    "highlightBackground": "#264F78",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#161B22",
    "menuForeground": "#C9D1D9",
    "menuSelectedBackground": "#58A6FF",
    "menuSelectedForeground": "#000000",
    "menuDescription": "#8B949E",
    "matchHighlight": "#D29922"
  },
  "prompt": {
    "separator": "plain",
    "newlineBeforeInput": false,
    "promptChar": "\u276f",
    "promptCharColor": "#58A6FF",
    "promptCharErrorColor": "#FF7B72",
    "continuationPrompt": "\u2219 ",
    "transientTemplate": "{promptChar} ",
    "left": [
      {
        "type": "admin",
        "foreground": "#FF7B72",
        "options": {
          "symbol": "ADMIN"
        }
      },
      {
        "type": "venv",
        "foreground": "#D29922",
        "template": "({value})"
      },
      {
        "type": "cwd",
        "foreground": "#58A6FF",
        "options": {
          "maxDepth": "3"
        }
      },
      {
        "type": "git",
        "foreground": "#3FB950",
        "template": "{icon} {value}",
        "icon": "\ue0a0"
      },
      {
        "type": "duration",
        "foreground": "#D29922",
        "template": "took {value}"
      },
      {
        "type": "jobs",
        "foreground": "#39C5CF",
        "template": "\u2699 {value}"
      }
    ],
    "right": [
      {
        "type": "status",
        "foreground": "#FF7B72"
      },
      {
        "type": "time",
        "foreground": "#6E7681",
        "options": {
          "format": "HH:mm"
        }
      }
    ]
  }
}
