<?xml version="1.0" encoding="utf-8"?>
<!-- Table views for the pk network tools (loaded on first use by NetFormats). Fixed widths: no AutoSize, so rows stream as they are found. -->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Pickle.Network.ScanRow</Name>
      <ViewSelectedBy><TypeName>Pickle.Network.ScanRow</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Host</Label></TableColumnHeader>
          <TableColumnHeader><Label>Port</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Service</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Banner</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Host</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Port</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Service</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Ms</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Banner</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Pickle.Network.SweepRow</Name>
      <ViewSelectedBy><TypeName>Pickle.Network.SweepRow</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Address</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Method</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>HostName</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Mac</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Address</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Ms</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Method</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>HostName</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Mac</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Pickle.Network.TraceRow</Name>
      <ViewSelectedBy><TypeName>Pickle.Network.TraceRow</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Hop</Label><Width>3</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Address</Label><Width>39</Width></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>HostName</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Hop</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Address</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Ms</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>HostName</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Pickle.Network.HttpRow</Name>
      <ViewSelectedBy><TypeName>Pickle.Network.HttpRow</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Status</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Ms</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ContentType</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>ContentLength</Label><Width>13</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Server</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Url</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Ms</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ContentType</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ContentLength</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Server</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Url</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Pickle.Network.IpRow</Name>
      <ViewSelectedBy><TypeName>Pickle.Network.IpRow</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>IPv4</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Gateway</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>DNS</Label><Width>24</Width></TableColumnHeader>
          <TableColumnHeader><Label>Mac</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>IPv4</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Gateway</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>DNS</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Mac</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Pickle.Network.SubnetRow</Name>
      <ViewSelectedBy><TypeName>Pickle.Network.SubnetRow</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Cidr</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>FirstHost</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>LastHost</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Hosts</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Cidr</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>FirstHost</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LastHost</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Hosts</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
