{
  "id": "remove-partition",
  "title": "Remove-Partition",
  "description": "Delete a partition and everything on it (diskpart 'delete partition').",
  "command": "Remove-Partition",
  "homepage": "https://learn.microsoft.com/powershell/module/storage/remove-partition",
  "windowsOnly": true,
  "sections": [
    {
      "title": "Partition",
      "options": [
        { "id": "driveLetter", "label": "Drive letter", "type": "text", "flag": "-DriveLetter", "validation": "^[A-Za-z]$", "placeholder": "E", "warning": "The partition and all its files are deleted." },
        { "id": "diskNumber", "label": "Disk number", "type": "number", "flag": "-DiskNumber", "validation": "^\\d+$", "dependsOn": "!driveLetter" },
        { "id": "partitionNumber", "label": "Partition number", "type": "number", "flag": "-PartitionNumber", "validation": "^\\d+$", "dependsOn": "!driveLetter", "warning": "The partition and all its files are deleted." }
      ]
    }
  ],
  "presets": [
    { "name": "Delete partition 2 of disk 1", "values": { "diskNumber": "1", "partitionNumber": "2" } }
  ]
}
