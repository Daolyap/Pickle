{
  "name": "aurora",
  "description": "Animated: northern-lights greens, teals and violets drifting across Powerline blocks. Needs a Nerd Font.",
  "terminal": {
    "background": "#0B1021",
    "foreground": "#D6E2FF",
    "cursorColor": "#3DDC97",
    "selectionBackground": "#24305A",
    "black": "#141A33",
    "red": "#E4572E",
    "green": "#3DDC97",
    "yellow": "#F3C969",
    "blue": "#4D9DE0",
    "purple": "#C77DFF",
    "cyan": "#2EC4B6",
    "white": "#D6E2FF",
    "brightBlack": "#4A557A",
    "brightRed": "#FF7A59",
    "brightGreen": "#6FF2B8",
    "brightYellow": "#FFE08A",
    "brightBlue": "#7FB8F0",
    "brightPurple": "#DDA8FF",
    "brightCyan": "#6FE3D6",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#3DDC97",
    "unknownCommand": "#E4572E",
    "parameter": "#6D7AA6",
    "string": "#F3C969",
    "number": "#C77DFF",
    "variable": "#6FE3D6",
    "operator": "#7FB8F0",
    "keyword": "#C77DFF",
    "comment": "#4A557A",
    "type": "#4D9DE0",
    "member": "#D6E2FF",
    "error": "#FF7A59",
    "suggestion": "#4A557A",
    "selectionBackground": "#24305A",
    "translated": "#4A557A"
  },
  "ui": {
    "accent": "#3DDC97",
    "muted": "#4A557A",
    "success": "#3DDC97",
    "warning": "#F3C969",
    "error": "#E4572E",
    "info": "#4D9DE0",
    "panelBackground": "#0B1021",
    "panelForeground": "#D6E2FF",
    "panelBorder": "#24305A",
    "highlightBackground": "#1B2340",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#10162C",
    "menuForeground": "#D6E2FF",
    "menuSelectedBackground": "#3DDC97",
    "menuSelectedForeground": "#0B1021",
    "menuDescription": "#7C88B0",
    "matchHighlight": "#F3C969"
  },
  "prompt": {
    "separator": "powerline",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#3DDC97",
    "promptCharErrorColor": "#E4572E",
    "continuationPrompt": "│ ",
    "transientTemplate": "{time} {promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#081018", "background": "#E4572E", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#081018", "background": "#3DDC97", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#081018", "background": "#2EC4B6", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#081018", "background": "#4D9DE0", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#081018", "background": "#7B61FF", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#E4572E", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#081018", "background": "#3DDC97", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#081018", "background": "#2EC4B6", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#081018", "background": "#4D9DE0", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#D6E2FF", "background": "#1B2340", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss", "animate": "false" } }
    ],
    "animation": {
      "effect": "wave",
      "colors": ["#3DDC97", "#2EC4B6", "#4D9DE0", "#7B61FF", "#C77DFF", "#4D9DE0"],
      "frameMs": 100,
      "periodMs": 6000,
      "spread": 0.12,
      "intensity": 0.6,
      "target": "auto",
      "promptChar": true,
      "promptChars": [],
      "promptCharFrames": 1
    }
  }
}
