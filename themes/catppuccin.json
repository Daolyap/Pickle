{
  "name": "catppuccin",
  "description": "Catppuccin Mocha: soft pastels on a two-line prompt with rounded blocks. Needs a Nerd Font.",
  "terminal": {
    "background": "#1E1E2E",
    "foreground": "#CDD6F4",
    "cursorColor": "#F5E0DC",
    "selectionBackground": "#45475A",
    "black": "#45475A",
    "red": "#F38BA8",
    "green": "#A6E3A1",
    "yellow": "#F9E2AF",
    "blue": "#89B4FA",
    "purple": "#F5C2E7",
    "cyan": "#94E2D5",
    "white": "#BAC2DE",
    "brightBlack": "#585B70",
    "brightRed": "#F38BA8",
    "brightGreen": "#A6E3A1",
    "brightYellow": "#F9E2AF",
    "brightBlue": "#89B4FA",
    "brightPurple": "#F5C2E7",
    "brightCyan": "#94E2D5",
    "brightWhite": "#A6ADC8"
  },
  "syntax": {
    "default": "default",
    "command": "#89B4FA",
    "unknownCommand": "#F38BA8",
    "parameter": "#6C7086",
    "string": "#A6E3A1",
    "number": "#FAB387",
    "variable": "#B4BEFE",
    "operator": "#89DCEB",
    "keyword": "#CBA6F7",
    "comment": "#6C7086",
    "type": "#F9E2AF",
    "member": "#CDD6F4",
    "error": "#F38BA8",
    "suggestion": "#6C7086",
    "selectionBackground": "#45475A",
    "translated": "#6C7086"
  },
  "ui": {
    "accent": "#CBA6F7",
    "muted": "#6C7086",
    "success": "#A6E3A1",
    "warning": "#F9E2AF",
    "error": "#F38BA8",
    "info": "#89DCEB",
    "panelBackground": "#1E1E2E",
    "panelForeground": "#CDD6F4",
    "panelBorder": "#45475A",
    "highlightBackground": "#313244",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#181825",
    "menuForeground": "#CDD6F4",
    "menuSelectedBackground": "#CBA6F7",
    "menuSelectedForeground": "#1E1E2E",
    "menuDescription": "#9399B2",
    "matchHighlight": "#F9E2AF"
  },
  "prompt": {
    "separator": "round",
    "newlineBeforeInput": true,
    "promptChar": "❯",
    "promptCharColor": "#CBA6F7",
    "promptCharErrorColor": "#F38BA8",
    "continuationPrompt": "│ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#11111B", "background": "#F38BA8", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#11111B", "background": "#CBA6F7", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#11111B", "background": "#A6E3A1", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#11111B", "background": "#FAB387", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#11111B", "background": "#94E2D5", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#F38BA8", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#11111B", "background": "#F9E2AF", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#11111B", "background": "#A6E3A1", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#11111B", "background": "#89B4FA", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#CDD6F4", "background": "#313244", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss" } }
    ]
  }
}
