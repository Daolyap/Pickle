{
  "name": "classic",
  "description": "Looks like stock PowerShell: 'PS C:\\path> ' on the Campbell PowerShell palette.",
  "terminal": {
    "background": "#012456",
    "foreground": "#CCCCCC",
    "cursorColor": "#FFFFFF",
    "selectionBackground": "#FFFFFF",
    "black": "#0C0C0C",
    "red": "#C50F1F",
    "green": "#13A10E",
    "yellow": "#C19C00",
    "blue": "#0037DA",
    "purple": "#881798",
    "cyan": "#3A96DD",
    "white": "#CCCCCC",
    "brightBlack": "#767676",
    "brightRed": "#E74856",
    "brightGreen": "#16C60C",
    "brightYellow": "#F9F1A5",
    "brightBlue": "#3B78FF",
    "brightPurple": "#B4009E",
    "brightCyan": "#61D6D6",
    "brightWhite": "#F2F2F2"
  },
  "syntax": {
    "default": "default",
    "command": "#F9F1A5",
    "unknownCommand": "#E74856",
    "parameter": "#767676",
    "string": "#3A96DD",
    "number": "#F2F2F2",
    "variable": "#16C60C",
    "operator": "#767676",
    "keyword": "#16C60C",
    "comment": "#13A10E",
    "type": "#CCCCCC",
    "member": "#F2F2F2",
    "error": "#E74856",
    "suggestion": "#767676",
    "selectionBackground": "#2C5AA0",
    "translated": "#767676"
  },
  "ui": {
    "accent": "#3A96DD",
    "muted": "#999999",
    "success": "#16C60C",
    "warning": "#F9F1A5",
    "error": "#E74856",
    "info": "#61D6D6",
    "panelBackground": "#012456",
    "panelForeground": "#CCCCCC",
    "panelBorder": "#3A96DD",
    "highlightBackground": "#2C5AA0",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#0C2A5A",
    "menuForeground": "#CCCCCC",
    "menuSelectedBackground": "#3A96DD",
    "menuSelectedForeground": "#012456",
    "menuDescription": "#999999",
    "matchHighlight": "#F9F1A5"
  },
  "prompt": {
    "separator": "none",
    "newlineBeforeInput": false,
    "promptChar": ">",
    "promptCharColor": "#CCCCCC",
    "promptCharErrorColor": "#CCCCCC",
    "continuationPrompt": ">> ",
    "transientTemplate": "PS {cwd}> ",
    "left": [
      { "type": "admin", "foreground": "#E74856", "template": "[{value}] ", "options": { "symbol": "ADMIN" } },
      { "type": "text", "foreground": "#CCCCCC", "template": "PS " },
      { "type": "cwd", "foreground": "#CCCCCC", "options": { "tildeHome": "false", "boldRepoRoot": "false" } }
    ],
    "right": []
  }
}
