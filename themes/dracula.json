{
  "name": "dracula",
  "description": "Dracula's dark purple palette with rounded blocks. Needs a Nerd Font.",
  "terminal": {
    "background": "#282A36",
    "foreground": "#F8F8F2",
    "cursorColor": "#F8F8F2",
    "selectionBackground": "#44475A",
    "black": "#21222C",
    "red": "#FF5555",
    "green": "#50FA7B",
    "yellow": "#F1FA8C",
    "blue": "#BD93F9",
    "purple": "#FF79C6",
    "cyan": "#8BE9FD",
    "white": "#F8F8F2",
    "brightBlack": "#6272A4",
    "brightRed": "#FF6E6E",
    "brightGreen": "#69FF94",
    "brightYellow": "#FFFFA5",
    "brightBlue": "#D6ACFF",
    "brightPurple": "#FF92DF",
    "brightCyan": "#A4FFFF",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#50FA7B",
    "unknownCommand": "#FF5555",
    "parameter": "#FFB86C",
    "string": "#F1FA8C",
    "number": "#BD93F9",
    "variable": "#F8F8F2",
    "operator": "#FF79C6",
    "keyword": "#FF79C6",
    "comment": "#6272A4",
    "type": "#8BE9FD",
    "member": "#F8F8F2",
    "error": "#FF6E6E",
    "suggestion": "#6272A4",
    "selectionBackground": "#44475A",
    "translated": "#6272A4"
  },
  "ui": {
    "accent": "#BD93F9",
    "muted": "#6272A4",
    "success": "#50FA7B",
    "warning": "#F1FA8C",
    "error": "#FF5555",
    "info": "#8BE9FD",
    "panelBackground": "#282A36",
    "panelForeground": "#F8F8F2",
    "panelBorder": "#44475A",
    "highlightBackground": "#44475A",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#21222C",
    "menuForeground": "#F8F8F2",
    "menuSelectedBackground": "#BD93F9",
    "menuSelectedForeground": "#282A36",
    "menuDescription": "#8A93C0",
    "matchHighlight": "#F1FA8C"
  },
  "prompt": {
    "separator": "round",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#FF79C6",
    "promptCharErrorColor": "#FF5555",
    "continuationPrompt": "│ ",
    "transientTemplate": "{time} {promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#282A36", "background": "#FF5555", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#282A36", "background": "#BD93F9", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#282A36", "background": "#50FA7B", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#282A36", "background": "#FFB86C", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#282A36", "background": "#8BE9FD", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#FF5555", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#282A36", "background": "#F1FA8C", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#282A36", "background": "#50FA7B", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#282A36", "background": "#8BE9FD", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#F8F8F2", "background": "#44475A", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss" } }
    ]
  }
}
