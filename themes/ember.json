{
  "name": "ember",
  "description": "Animated: glowing coals — red and orange blocks breathing brighter and back. Needs a Nerd Font.",
  "terminal": {
    "background": "#1B0F0A",
    "foreground": "#F6E3D0",
    "cursorColor": "#F8961E",
    "selectionBackground": "#4A2A1C",
    "black": "#2A1810",
    "red": "#E4572E",
    "green": "#90BE6D",
    "yellow": "#F9C74F",
    "blue": "#577590",
    "purple": "#C06C84",
    "cyan": "#43AA8B",
    "white": "#F6E3D0",
    "brightBlack": "#6B4A3A",
    "brightRed": "#FF7B54",
    "brightGreen": "#B5E48C",
    "brightYellow": "#FFD97D",
    "brightBlue": "#7FA6C9",
    "brightPurple": "#E29AB2",
    "brightCyan": "#6FD3B5",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#F8961E",
    "unknownCommand": "#E4572E",
    "parameter": "#8C6A58",
    "string": "#F9C74F",
    "number": "#FF7B54",
    "variable": "#FFD97D",
    "operator": "#C9A48D",
    "keyword": "#E4572E",
    "comment": "#6B4A3A",
    "type": "#90BE6D",
    "member": "#F6E3D0",
    "error": "#FF7B54",
    "suggestion": "#6B4A3A",
    "selectionBackground": "#4A2A1C",
    "translated": "#6B4A3A"
  },
  "ui": {
    "accent": "#F8961E",
    "muted": "#6B4A3A",
    "success": "#90BE6D",
    "warning": "#F9C74F",
    "error": "#E4572E",
    "info": "#F3722C",
    "panelBackground": "#1B0F0A",
    "panelForeground": "#F6E3D0",
    "panelBorder": "#4A2A1C",
    "highlightBackground": "#3A1F14",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#241410",
    "menuForeground": "#F6E3D0",
    "menuSelectedBackground": "#F8961E",
    "menuSelectedForeground": "#1B0F0A",
    "menuDescription": "#A07E6A",
    "matchHighlight": "#F9C74F"
  },
  "prompt": {
    "separator": "slant",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#F8961E",
    "promptCharErrorColor": "#C1121F",
    "continuationPrompt": "│ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#1B0F0A", "background": "#C1121F", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#1B0F0A", "background": "#E4572E", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#1B0F0A", "background": "#F3722C", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#1B0F0A", "background": "#F8961E", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#1B0F0A", "background": "#F9C74F", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#C1121F", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#1B0F0A", "background": "#F9C74F", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#1B0F0A", "background": "#F8961E", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#1B0F0A", "background": "#F3722C", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#F6E3D0", "background": "#3A1F14", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss", "animate": "false" } }
    ],
    "animation": {
      "effect": "pulse",
      "colors": ["#FFE8A3"],
      "frameMs": 100,
      "periodMs": 2600,
      "spread": 0.1,
      "intensity": 0.55,
      "target": "auto",
      "promptChar": true,
      "promptChars": [],
      "promptCharFrames": 1
    }
  }
}
