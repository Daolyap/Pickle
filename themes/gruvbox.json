{
  "name": "gruvbox",
  "description": "Gruvbox's warm retro colors with slanted blocks. Needs a Nerd Font.",
  "terminal": {
    "background": "#282828",
    "foreground": "#EBDBB2",
    "cursorColor": "#EBDBB2",
    "selectionBackground": "#504945",
    "black": "#282828",
    "red": "#CC241D",
    "green": "#98971A",
    "yellow": "#D79921",
    "blue": "#458588",
    "purple": "#B16286",
    "cyan": "#689D6A",
    "white": "#A89984",
    "brightBlack": "#928374",
    "brightRed": "#FB4934",
    "brightGreen": "#B8BB26",
    "brightYellow": "#FABD2F",
    "brightBlue": "#83A598",
    "brightPurple": "#D3869B",
    "brightCyan": "#8EC07C",
    "brightWhite": "#EBDBB2"
  },
  "syntax": {
    "default": "default",
    "command": "#B8BB26",
    "unknownCommand": "#FB4934",
    "parameter": "#928374",
    "string": "#FABD2F",
    "number": "#D3869B",
    "variable": "#83A598",
    "operator": "#FE8019",
    "keyword": "#FB4934",
    "comment": "#928374",
    "type": "#8EC07C",
    "member": "#EBDBB2",
    "error": "#FB4934",
    "suggestion": "#928374",
    "selectionBackground": "#504945",
    "translated": "#928374"
  },
  "ui": {
    "accent": "#FABD2F",
    "muted": "#928374",
    "success": "#B8BB26",
    "warning": "#FE8019",
    "error": "#FB4934",
    "info": "#83A598",
    "panelBackground": "#282828",
    "panelForeground": "#EBDBB2",
    "panelBorder": "#504945",
    "highlightBackground": "#504945",
    "highlightForeground": "#FBF1C7",
    "menuBackground": "#3C3836",
    "menuForeground": "#EBDBB2",
    "menuSelectedBackground": "#FABD2F",
    "menuSelectedForeground": "#282828",
    "menuDescription": "#A89984",
    "matchHighlight": "#FE8019"
  },
  "prompt": {
    "separator": "slant",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#FABD2F",
    "promptCharErrorColor": "#FB4934",
    "continuationPrompt": "│ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#282828", "background": "#CC241D", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#282828", "background": "#FABD2F", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#282828", "background": "#8EC07C", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#282828", "background": "#FE8019", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#282828", "background": "#83A598", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#CC241D", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#282828", "background": "#FABD2F", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#282828", "background": "#B8BB26", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#282828", "background": "#83A598", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#EBDBB2", "background": "#504945", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss" } }
    ]
  }
}
