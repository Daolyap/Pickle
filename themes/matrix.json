{
  "name": "matrix",
  "description": "Animated: phosphor green on black, a bright band sweeping through the prompt and a blinking block cursor.",
  "terminal": {
    "background": "#020A04",
    "foreground": "#8CFF9E",
    "cursorColor": "#00FF41",
    "selectionBackground": "#0F3D1A",
    "black": "#020A04",
    "red": "#FF3B3B",
    "green": "#00FF41",
    "yellow": "#C6FF4D",
    "blue": "#26C281",
    "purple": "#6FFFB0",
    "cyan": "#3DFFA2",
    "white": "#8CFF9E",
    "brightBlack": "#0A5C1E",
    "brightRed": "#FF6B6B",
    "brightGreen": "#7DFF9A",
    "brightYellow": "#E4FF8A",
    "brightBlue": "#5FE3A8",
    "brightPurple": "#A6FFD0",
    "brightCyan": "#8CFFD2",
    "brightWhite": "#D8FFD8"
  },
  "syntax": {
    "default": "default",
    "command": "#00FF41",
    "unknownCommand": "#FF3B3B",
    "parameter": "#3E8F52",
    "string": "#C6FF4D",
    "number": "#6FFFB0",
    "variable": "#3DFFA2",
    "operator": "#3E8F52",
    "keyword": "#7DFF9A",
    "comment": "#0A5C1E",
    "type": "#26C281",
    "member": "#8CFF9E",
    "error": "#FF6B6B",
    "suggestion": "#0A5C1E",
    "selectionBackground": "#0F3D1A",
    "translated": "#0A5C1E"
  },
  "ui": {
    "accent": "#00FF41",
    "muted": "#0A5C1E",
    "success": "#00FF41",
    "warning": "#C6FF4D",
    "error": "#FF3B3B",
    "info": "#3DFFA2",
    "panelBackground": "#020A04",
    "panelForeground": "#8CFF9E",
    "panelBorder": "#0F3D1A",
    "highlightBackground": "#0F3D1A",
    "highlightForeground": "#D8FFD8",
    "menuBackground": "#041408",
    "menuForeground": "#8CFF9E",
    "menuSelectedBackground": "#00FF41",
    "menuSelectedForeground": "#020A04",
    "menuDescription": "#3E8F52",
    "matchHighlight": "#C6FF4D"
  },
  "prompt": {
    "separator": "plain",
    "newlineBeforeInput": false,
    "promptChar": "▮",
    "promptCharColor": "#00FF41",
    "promptCharErrorColor": "#FF3B3B",
    "continuationPrompt": "∙ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#FF3B3B", "options": { "symbol": "ADMIN" } },
      { "type": "venv", "foreground": "#9AF7A8", "template": "({value})" },
      { "type": "cwd", "foreground": "#00FF41", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#39D353", "template": "{icon} {value}", "icon": "" },
      { "type": "duration", "foreground": "#9AF7A8", "template": "took {value}" },
      { "type": "jobs", "foreground": "#39D353", "template": "⚙ {value}" }
    ],
    "right": [
      { "type": "status", "foreground": "#FF3B3B" },
      { "type": "time", "foreground": "#0A5C1E", "options": { "format": "HH:mm" } }
    ],
    "animation": {
      "effect": "shimmer",
      "colors": ["#D8FFD8"],
      "frameMs": 80,
      "periodMs": 2400,
      "spread": 0.15,
      "intensity": 0.85,
      "target": "foreground",
      "promptChar": true,
      "promptChars": ["▮", "▯"],
      "promptCharFrames": 6
    }
  }
}
