{
  "name": "mono",
  "description": "Grayscale and high contrast. State is spelled out in text, never conveyed by color alone.",
  "terminal": {
    "background": "#121212",
    "foreground": "#E0E0E0",
    "cursorColor": "#FFFFFF",
    "selectionBackground": "#4A4A4A",
    "black": "#121212",
    "red": "#B0B0B0",
    "green": "#C8C8C8",
    "yellow": "#D8D8D8",
    "blue": "#A0A0A0",
    "purple": "#BCBCBC",
    "cyan": "#CFCFCF",
    "white": "#E0E0E0",
    "brightBlack": "#8A8A8A",
    "brightRed": "#D0D0D0",
    "brightGreen": "#E4E4E4",
    "brightYellow": "#F0F0F0",
    "brightBlue": "#C0C0C0",
    "brightPurple": "#D6D6D6",
    "brightCyan": "#E8E8E8",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#FFFFFF",
    "unknownCommand": "#8A8A8A",
    "parameter": "#B0B0B0",
    "string": "#D0D0D0",
    "number": "#E8E8E8",
    "variable": "#C8C8C8",
    "operator": "#A0A0A0",
    "keyword": "#FFFFFF",
    "comment": "#8A8A8A",
    "type": "#D8D8D8",
    "member": "#E0E0E0",
    "error": "#FFFFFF",
    "suggestion": "#8A8A8A",
    "selectionBackground": "#4A4A4A",
    "translated": "#8A8A8A"
  },
  "ui": {
    "accent": "#FFFFFF",
    "muted": "#8A8A8A",
    "success": "#E0E0E0",
    "warning": "#F0F0F0",
    "error": "#FFFFFF",
    "info": "#C8C8C8",
    "panelBackground": "#121212",
    "panelForeground": "#E0E0E0",
    "panelBorder": "#6E6E6E",
    "highlightBackground": "#4A4A4A",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#1E1E1E",
    "menuForeground": "#E0E0E0",
    "menuSelectedBackground": "#E0E0E0",
    "menuSelectedForeground": "#121212",
    "menuDescription": "#A0A0A0",
    "matchHighlight": "#FFFFFF"
  },
  "prompt": {
    "separator": "plain",
    "newlineBeforeInput": false,
    "promptChar": ">",
    "promptCharColor": "#E0E0E0",
    "promptCharErrorColor": "#FFFFFF",
    "continuationPrompt": ". ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#FFFFFF", "template": "[{value}]", "options": { "symbol": "ADMIN" } },
      { "type": "venv", "foreground": "#B0B0B0", "template": "({value})" },
      { "type": "cwd", "foreground": "#E0E0E0", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#B0B0B0", "template": "on {value}" },
      { "type": "duration", "foreground": "#A0A0A0", "template": "took {value}" },
      { "type": "jobs", "foreground": "#A0A0A0", "template": "jobs:{value}" },
      { "type": "status", "foreground": "#FFFFFF", "template": "[{value}]", "options": { "symbol": "failed" } }
    ],
    "right": [
      { "type": "time", "foreground": "#8A8A8A", "options": { "format": "HH:mm" } }
    ]
  }
}
