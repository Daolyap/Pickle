{
  "name": "nord",
  "description": "Arctic blues and frost from the Nord palette, quiet one-line prompt.",
  "terminal": {
    "background": "#2E3440",
    "foreground": "#D8DEE9",
    "cursorColor": "#D8DEE9",
    "selectionBackground": "#434C5E",
    "black": "#3B4252",
    "red": "#BF616A",
    "green": "#A3BE8C",
    "yellow": "#EBCB8B",
    "blue": "#81A1C1",
    "purple": "#B48EAD",
    "cyan": "#88C0D0",
    "white": "#E5E9F0",
    "brightBlack": "#4C566A",
    "brightRed": "#BF616A",
    "brightGreen": "#A3BE8C",
    "brightYellow": "#EBCB8B",
    "brightBlue": "#81A1C1",
    "brightPurple": "#B48EAD",
    "brightCyan": "#8FBCBB",
    "brightWhite": "#ECEFF4"
  },
  "syntax": {
    "default": "default",
    "command": "#88C0D0",
    "unknownCommand": "#BF616A",
    "parameter": "#4C566A",
    "string": "#A3BE8C",
    "number": "#B48EAD",
    "variable": "#D8DEE9",
    "operator": "#81A1C1",
    "keyword": "#81A1C1",
    "comment": "#616E88",
    "type": "#8FBCBB",
    "member": "#D8DEE9",
    "error": "#BF616A",
    "suggestion": "#616E88",
    "selectionBackground": "#434C5E",
    "translated": "#616E88"
  },
  "ui": {
    "accent": "#88C0D0",
    "muted": "#4C566A",
    "success": "#A3BE8C",
    "warning": "#EBCB8B",
    "error": "#BF616A",
    "info": "#81A1C1",
    "panelBackground": "#2E3440",
    "panelForeground": "#D8DEE9",
    "panelBorder": "#434C5E",
    "highlightBackground": "#434C5E",
    "highlightForeground": "#ECEFF4",
    "menuBackground": "#3B4252",
    "menuForeground": "#D8DEE9",
    "menuSelectedBackground": "#88C0D0",
    "menuSelectedForeground": "#2E3440",
    "menuDescription": "#7B88A1",
    "matchHighlight": "#EBCB8B"
  },
  "prompt": {
    "separator": "plain",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#88C0D0",
    "promptCharErrorColor": "#BF616A",
    "continuationPrompt": "∙ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#BF616A", "options": { "symbol": "ADMIN" } },
      { "type": "venv", "foreground": "#EBCB8B", "template": "({value})" },
      { "type": "cwd", "foreground": "#88C0D0", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#A3BE8C", "template": "{icon} {value}", "icon": "" },
      { "type": "duration", "foreground": "#EBCB8B", "template": "took {value}" },
      { "type": "jobs", "foreground": "#8FBCBB", "template": "⚙ {value}" }
    ],
    "right": [
      { "type": "status", "foreground": "#BF616A" },
      { "type": "time", "foreground": "#4C566A", "options": { "format": "HH:mm" } }
    ]
  }
}
