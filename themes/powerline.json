{
  "name": "powerline",
  "description": "Powerline blocks with Nerd Font icons on a two-line prompt. Needs a Nerd Font (e.g. Cascadia Code NF).",
  "terminal": {
    "background": "#282C34",
    "foreground": "#ABB2BF",
    "cursorColor": "#528BFF",
    "selectionBackground": "#3E4451",
    "black": "#282C34",
    "red": "#E06C75",
    "green": "#98C379",
    "yellow": "#E5C07B",
    "blue": "#61AFEF",
    "purple": "#C678DD",
    "cyan": "#56B6C2",
    "white": "#ABB2BF",
    "brightBlack": "#5C6370",
    "brightRed": "#E88388",
    "brightGreen": "#A9D08E",
    "brightYellow": "#EBCB8B",
    "brightBlue": "#7CBEF2",
    "brightPurple": "#D19AE6",
    "brightCyan": "#6BC5D0",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#61AFEF",
    "unknownCommand": "#E06C75",
    "parameter": "#7F848E",
    "string": "#98C379",
    "number": "#D19A66",
    "variable": "#E5C07B",
    "operator": "#56B6C2",
    "keyword": "#C678DD",
    "comment": "#5C6370",
    "type": "#E5C07B",
    "member": "#ABB2BF",
    "error": "#E88388",
    "suggestion": "#5C6370",
    "selectionBackground": "#3E4451",
    "translated": "#5C6370"
  },
  "ui": {
    "accent": "#61AFEF",
    "muted": "#5C6370",
    "success": "#98C379",
    "warning": "#E5C07B",
    "error": "#E06C75",
    "info": "#56B6C2",
    "panelBackground": "#282C34",
    "panelForeground": "#ABB2BF",
    "panelBorder": "#3E4451",
    "highlightBackground": "#3E4451",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#21252B",
    "menuForeground": "#ABB2BF",
    "menuSelectedBackground": "#61AFEF",
    "menuSelectedForeground": "#282C34",
    "menuDescription": "#7F848E",
    "matchHighlight": "#E5C07B"
  },
  "prompt": {
    "separator": "powerline",
    "newlineBeforeInput": true,
    "promptChar": "❯",
    "promptCharColor": "#98C379",
    "promptCharErrorColor": "#E06C75",
    "continuationPrompt": "│ ",
    "transientTemplate": "{time} {promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#282C34", "background": "#E06C75", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#282C34", "background": "#61AFEF", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#282C34", "background": "#98C379", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#282C34", "background": "#E5C07B", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#282C34", "background": "#56B6C2", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#E06C75", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#282C34", "background": "#E5C07B", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#282C34", "background": "#98C379", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#282C34", "background": "#61AFEF", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#ABB2BF", "background": "#3E4451", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss" } }
    ]
  }
}
