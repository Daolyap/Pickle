{
  "name": "prism",
  "description": "Animated: Powerline blocks slowly cycling through the rainbow, one step apart. Needs a Nerd Font.",
  "terminal": {
    "background": "#111318",
    "foreground": "#E6E9EF",
    "cursorColor": "#FFD166",
    "selectionBackground": "#2C313C",
    "black": "#1A1D24",
    "red": "#FF6B6B",
    "green": "#06D6A0",
    "yellow": "#FFD166",
    "blue": "#4CC9F0",
    "purple": "#B388FF",
    "cyan": "#2EC4B6",
    "white": "#E6E9EF",
    "brightBlack": "#4B5263",
    "brightRed": "#FF8787",
    "brightGreen": "#3DEBB9",
    "brightYellow": "#FFE08A",
    "brightBlue": "#7DD8F5",
    "brightPurple": "#CBAAFF",
    "brightCyan": "#5ED9CE",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#06D6A0",
    "unknownCommand": "#FF6B6B",
    "parameter": "#7A8194",
    "string": "#FFD166",
    "number": "#B388FF",
    "variable": "#4CC9F0",
    "operator": "#FF6BD6",
    "keyword": "#B388FF",
    "comment": "#4B5263",
    "type": "#2EC4B6",
    "member": "#E6E9EF",
    "error": "#FF8787",
    "suggestion": "#4B5263",
    "selectionBackground": "#2C313C",
    "translated": "#4B5263"
  },
  "ui": {
    "accent": "#4CC9F0",
    "muted": "#4B5263",
    "success": "#06D6A0",
    "warning": "#FFD166",
    "error": "#FF6B6B",
    "info": "#4CC9F0",
    "panelBackground": "#111318",
    "panelForeground": "#E6E9EF",
    "panelBorder": "#2C313C",
    "highlightBackground": "#23262E",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#16181E",
    "menuForeground": "#E6E9EF",
    "menuSelectedBackground": "#4CC9F0",
    "menuSelectedForeground": "#111318",
    "menuDescription": "#8A91A5",
    "matchHighlight": "#FFD166"
  },
  "prompt": {
    "separator": "powerline",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#FFD166",
    "promptCharErrorColor": "#EF233C",
    "continuationPrompt": "│ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#0E1014", "background": "#EF233C", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#0E1014", "background": "#FF6B6B", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#0E1014", "background": "#FFD166", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#0E1014", "background": "#06D6A0", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#0E1014", "background": "#4CC9F0", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#EF233C", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#0E1014", "background": "#B388FF", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#0E1014", "background": "#FF6BD6", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#0E1014", "background": "#4CC9F0", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#E6E9EF", "background": "#23262E", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss", "animate": "false" } }
    ],
    "animation": {
      "effect": "rainbow",
      "colors": [],
      "frameMs": 120,
      "periodMs": 9000,
      "spread": 0.1,
      "intensity": 0.6,
      "target": "auto",
      "promptChar": true,
      "promptChars": [],
      "promptCharFrames": 1
    }
  }
}
