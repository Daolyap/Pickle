{
  "name": "rose-pine",
  "description": "Rosé Pine: muted roses, pine and iris for a calm one-line prompt.",
  "terminal": {
    "background": "#191724",
    "foreground": "#E0DEF4",
    "cursorColor": "#EBBCBA",
    "selectionBackground": "#403D52",
    "black": "#26233A",
    "red": "#EB6F92",
    "green": "#31748F",
    "yellow": "#F6C177",
    "blue": "#9CCFD8",
    "purple": "#C4A7E7",
    "cyan": "#EBBCBA",
    "white": "#E0DEF4",
    "brightBlack": "#6E6A86",
    "brightRed": "#EB6F92",
    "brightGreen": "#31748F",
    "brightYellow": "#F6C177",
    "brightBlue": "#9CCFD8",
    "brightPurple": "#C4A7E7",
    "brightCyan": "#EBBCBA",
    "brightWhite": "#E0DEF4"
  },
  "syntax": {
    "default": "default",
    "command": "#9CCFD8",
    "unknownCommand": "#EB6F92",
    "parameter": "#908CAA",
    "string": "#F6C177",
    "number": "#C4A7E7",
    "variable": "#EBBCBA",
    "operator": "#908CAA",
    "keyword": "#31748F",
    "comment": "#6E6A86",
    "type": "#9CCFD8",
    "member": "#E0DEF4",
    "error": "#EB6F92",
    "suggestion": "#6E6A86",
    "selectionBackground": "#403D52",
    "translated": "#6E6A86"
  },
  "ui": {
    "accent": "#C4A7E7",
    "muted": "#6E6A86",
    "success": "#9CCFD8",
    "warning": "#F6C177",
    "error": "#EB6F92",
    "info": "#9CCFD8",
    "panelBackground": "#191724",
    "panelForeground": "#E0DEF4",
    "panelBorder": "#403D52",
    "highlightBackground": "#403D52",
    "highlightForeground": "#E0DEF4",
    "menuBackground": "#1F1D2E",
    "menuForeground": "#E0DEF4",
    "menuSelectedBackground": "#C4A7E7",
    "menuSelectedForeground": "#191724",
    "menuDescription": "#908CAA",
    "matchHighlight": "#F6C177"
  },
  "prompt": {
    "separator": "plain",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#C4A7E7",
    "promptCharErrorColor": "#EB6F92",
    "continuationPrompt": "∙ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#EB6F92", "options": { "symbol": "ADMIN" } },
      { "type": "venv", "foreground": "#F6C177", "template": "({value})" },
      { "type": "cwd", "foreground": "#C4A7E7", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#9CCFD8", "template": "{icon} {value}", "icon": "" },
      { "type": "duration", "foreground": "#F6C177", "template": "took {value}" },
      { "type": "jobs", "foreground": "#EBBCBA", "template": "⚙ {value}" }
    ],
    "right": [
      { "type": "status", "foreground": "#EB6F92" },
      { "type": "time", "foreground": "#6E6A86", "options": { "format": "HH:mm" } }
    ]
  }
}
