{
  "name": "solarized-light",
  "description": "Solarized Light: a light background theme with Solarized's accent colors.",
  "terminal": {
    "background": "#FDF6E3",
    "foreground": "#657B83",
    "cursorColor": "#586E75",
    "selectionBackground": "#EEE8D5",
    "black": "#002B36",
    "red": "#DC322F",
    "green": "#859900",
    "yellow": "#B58900",
    "blue": "#268BD2",
    "purple": "#D33682",
    "cyan": "#2AA198",
    "white": "#EEE8D5",
    "brightBlack": "#073642",
    "brightRed": "#CB4B16",
    "brightGreen": "#586E75",
    "brightYellow": "#657B83",
    "brightBlue": "#839496",
    "brightPurple": "#6C71C4",
    "brightCyan": "#93A1A1",
    "brightWhite": "#FDF6E3"
  },
  "syntax": {
    "default": "default",
    "command": "#268BD2",
    "unknownCommand": "#DC322F",
    "parameter": "#93A1A1",
    "string": "#2AA198",
    "number": "#D33682",
    "variable": "#CB4B16",
    "operator": "#586E75",
    "keyword": "#859900",
    "comment": "#93A1A1",
    "type": "#B58900",
    "member": "#586E75",
    "error": "#DC322F",
    "suggestion": "#93A1A1",
    "selectionBackground": "#EEE8D5",
    "translated": "#93A1A1"
  },
  "ui": {
    "accent": "#268BD2",
    "muted": "#93A1A1",
    "success": "#859900",
    "warning": "#B58900",
    "error": "#DC322F",
    "info": "#2AA198",
    "panelBackground": "#FDF6E3",
    "panelForeground": "#657B83",
    "panelBorder": "#D9D2C2",
    "highlightBackground": "#EEE8D5",
    "highlightForeground": "#073642",
    "menuBackground": "#EEE8D5",
    "menuForeground": "#657B83",
    "menuSelectedBackground": "#268BD2",
    "menuSelectedForeground": "#FDF6E3",
    "menuDescription": "#839496",
    "matchHighlight": "#CB4B16"
  },
  "prompt": {
    "separator": "plain",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#268BD2",
    "promptCharErrorColor": "#DC322F",
    "continuationPrompt": "∙ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#DC322F", "options": { "symbol": "ADMIN" } },
      { "type": "venv", "foreground": "#B58900", "template": "({value})" },
      { "type": "cwd", "foreground": "#268BD2", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#859900", "template": "{icon} {value}", "icon": "" },
      { "type": "duration", "foreground": "#B58900", "template": "took {value}" },
      { "type": "jobs", "foreground": "#2AA198", "template": "⚙ {value}" }
    ],
    "right": [
      { "type": "status", "foreground": "#DC322F" },
      { "type": "time", "foreground": "#93A1A1", "options": { "format": "HH:mm" } }
    ]
  }
}
