{
  "name": "synthwave",
  "description": "Animated: an '84 sunset — neon pink, purple and cyan rolling through rounded blocks. Needs a Nerd Font.",
  "terminal": {
    "background": "#1A0B2E",
    "foreground": "#F5E6FF",
    "cursorColor": "#FF2E97",
    "selectionBackground": "#3B1F66",
    "black": "#241038",
    "red": "#FF3864",
    "green": "#72F1B8",
    "yellow": "#FFD319",
    "blue": "#3CF6FF",
    "purple": "#FF2E97",
    "cyan": "#36F9F6",
    "white": "#F5E6FF",
    "brightBlack": "#5C3F84",
    "brightRed": "#FF6B8B",
    "brightGreen": "#9CFFD4",
    "brightYellow": "#FFE66D",
    "brightBlue": "#7DF9FF",
    "brightPurple": "#FF7EDB",
    "brightCyan": "#8BFFFD",
    "brightWhite": "#FFFFFF"
  },
  "syntax": {
    "default": "default",
    "command": "#36F9F6",
    "unknownCommand": "#FF3864",
    "parameter": "#8E77B5",
    "string": "#FF8B39",
    "number": "#F97E72",
    "variable": "#FF7EDB",
    "operator": "#72F1B8",
    "keyword": "#FEDE5D",
    "comment": "#6D5A99",
    "type": "#3CF6FF",
    "member": "#F5E6FF",
    "error": "#FF6B8B",
    "suggestion": "#6D5A99",
    "selectionBackground": "#3B1F66",
    "translated": "#6D5A99"
  },
  "ui": {
    "accent": "#FF2E97",
    "muted": "#6D5A99",
    "success": "#72F1B8",
    "warning": "#FFD319",
    "error": "#FF3864",
    "info": "#3CF6FF",
    "panelBackground": "#1A0B2E",
    "panelForeground": "#F5E6FF",
    "panelBorder": "#3B1F66",
    "highlightBackground": "#2D1B4E",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#200D38",
    "menuForeground": "#F5E6FF",
    "menuSelectedBackground": "#FF2E97",
    "menuSelectedForeground": "#1A0B2E",
    "menuDescription": "#9D86C9",
    "matchHighlight": "#FFD319"
  },
  "prompt": {
    "separator": "round",
    "newlineBeforeInput": true,
    "promptChar": "❯",
    "promptCharColor": "#FF2E97",
    "promptCharErrorColor": "#FF3864",
    "continuationPrompt": "│ ",
    "transientTemplate": "{promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#14061F", "background": "#FF3864", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#14061F", "background": "#FF2E97", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#14061F", "background": "#B537F2", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#14061F", "background": "#3CF6FF", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#14061F", "background": "#FFD319", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#FF3864", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#14061F", "background": "#FFD319", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#14061F", "background": "#3CF6FF", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#14061F", "background": "#B537F2", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#F5E6FF", "background": "#2D1B4E", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss", "animate": "false" } }
    ],
    "animation": {
      "effect": "wave",
      "colors": ["#FF2E97", "#B537F2", "#3CF6FF", "#B537F2"],
      "frameMs": 90,
      "periodMs": 3200,
      "spread": 0.18,
      "intensity": 0.6,
      "target": "auto",
      "promptChar": true,
      "promptChars": [],
      "promptCharFrames": 1
    }
  }
}
