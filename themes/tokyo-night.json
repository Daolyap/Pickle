{
  "name": "tokyo-night",
  "description": "Tokyo Night's neon-on-navy colors with Powerline blocks. Needs a Nerd Font.",
  "terminal": {
    "background": "#1A1B26",
    "foreground": "#C0CAF5",
    "cursorColor": "#C0CAF5",
    "selectionBackground": "#33467C",
    "black": "#15161E",
    "red": "#F7768E",
    "green": "#9ECE6A",
    "yellow": "#E0AF68",
    "blue": "#7AA2F7",
    "purple": "#BB9AF7",
    "cyan": "#7DCFFF",
    "white": "#A9B1D6",
    "brightBlack": "#414868",
    "brightRed": "#F7768E",
    "brightGreen": "#9ECE6A",
    "brightYellow": "#E0AF68",
    "brightBlue": "#7AA2F7",
    "brightPurple": "#BB9AF7",
    "brightCyan": "#7DCFFF",
    "brightWhite": "#C0CAF5"
  },
  "syntax": {
    "default": "default",
    "command": "#7AA2F7",
    "unknownCommand": "#F7768E",
    "parameter": "#565F89",
    "string": "#9ECE6A",
    "number": "#FF9E64",
    "variable": "#C0CAF5",
    "operator": "#7DCFFF",
    "keyword": "#BB9AF7",
    "comment": "#565F89",
    "type": "#73DACA",
    "member": "#A9B1D6",
    "error": "#F7768E",
    "suggestion": "#565F89",
    "selectionBackground": "#33467C",
    "translated": "#565F89"
  },
  "ui": {
    "accent": "#7AA2F7",
    "muted": "#565F89",
    "success": "#9ECE6A",
    "warning": "#E0AF68",
    "error": "#F7768E",
    "info": "#7DCFFF",
    "panelBackground": "#1A1B26",
    "panelForeground": "#C0CAF5",
    "panelBorder": "#414868",
    "highlightBackground": "#292E42",
    "highlightForeground": "#FFFFFF",
    "menuBackground": "#16161E",
    "menuForeground": "#C0CAF5",
    "menuSelectedBackground": "#7AA2F7",
    "menuSelectedForeground": "#1A1B26",
    "menuDescription": "#737AA2",
    "matchHighlight": "#FF9E64"
  },
  "prompt": {
    "separator": "powerline",
    "newlineBeforeInput": false,
    "promptChar": "❯",
    "promptCharColor": "#BB9AF7",
    "promptCharErrorColor": "#F7768E",
    "continuationPrompt": "│ ",
    "transientTemplate": "{time} {promptChar} ",
    "left": [
      { "type": "admin", "foreground": "#1A1B26", "background": "#F7768E", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "cwd", "foreground": "#1A1B26", "background": "#7AA2F7", "template": " {icon} {value} ", "icon": "", "options": { "maxDepth": "3" } },
      { "type": "git", "foreground": "#1A1B26", "background": "#9ECE6A", "template": " {icon} {value} ", "icon": "" },
      { "type": "duration", "foreground": "#1A1B26", "background": "#E0AF68", "template": " {icon} {value} ", "icon": "" },
      { "type": "jobs", "foreground": "#1A1B26", "background": "#73DACA", "template": " {icon} {value} ", "icon": "" }
    ],
    "right": [
      { "type": "status", "foreground": "#FFFFFF", "background": "#F7768E", "template": " {value} ", "options": { "symbol": "" } },
      { "type": "venv", "foreground": "#1A1B26", "background": "#E0AF68", "template": " {icon} {value} ", "icon": "" },
      { "type": "node", "foreground": "#1A1B26", "background": "#9ECE6A", "template": " {icon} {value} ", "icon": "" },
      { "type": "k8s", "foreground": "#1A1B26", "background": "#7AA2F7", "template": " {icon} {value} ", "icon": "󱃾" },
      { "type": "time", "foreground": "#C0CAF5", "background": "#292E42", "template": " {icon} {value} ", "icon": "", "options": { "format": "HH:mm:ss" } }
    ]
  }
}
